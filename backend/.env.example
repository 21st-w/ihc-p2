# FinTrack — Environment Variables
# Copie para .env e preencha os valores reais.
# NUNCA comite o .env real no repositório.

PROJECT_NAME=FinTrack API
API_V1_STR=/api/v1

# === Segurança ===
SECRET_KEY=GERE_UMA_CHAVE_COM_256_BITS_OU_MAIS
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Banco de Dados ===
POSTGRES_URL=postgresql://fintrack:fintrack_dev@localhost:5432/fintrack

# === Redis ===
REDIS_URL=redis://:fintrack_redis_dev@localhost:6379

# === IA (Fase 3+) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Vault Obsidian ===
VAULT_PATH=/absolute/path/to/vault
