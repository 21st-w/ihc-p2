# Database
POSTGRES_URL=postgresql://finbrain:finbrain@localhost:5432/finbrain
POSTGRES_USER=finbrain
POSTGRES_PASSWORD=finbrain
POSTGRES_DB=finbrain

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-256-bit-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
